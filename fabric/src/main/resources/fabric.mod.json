{
  "schemaVersion": 1,
  "id": "mediapanelhologram",
  "version": "${version}",
  "name": "Media Panel & Hologram",
  "description": "Thin panel blocks and holograms that display images, videos, music and web pages in Minecraft.",
  "authors": [
    "kiyo"
  ],
  "contact": {
    "homepage": "https://github.com/29kiyo/Media-Panel-Hologram",
    "sources": "https://github.com/29kiyo/Media-Panel-Hologram",
    "issues": "https://github.com/29kiyo/Media-Panel-Hologram/issues"
  },
  "license": "LGPL-2.1-or-later",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "io.github.kiyo.mediapanelhologram.fabric.MediaPanelHologramFabric"
    ],
    "client": [
      "io.github.kiyo.mediapanelhologram.fabric.client.MediaPanelHologramFabricClient"
    ]
  },
  "mixins": [
    "mediapanelhologram.mixins.json",
    "mcef.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*",
    "geckolib": ">=5.5",
    "architectury": ">=21.0"
  }
}
